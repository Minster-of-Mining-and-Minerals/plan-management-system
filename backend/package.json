{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:create": "sequelize-cli db:create",
    "db:drop": "sequelize-cli db:drop",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate",
    "db:reset:seed": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "db:fresh": "sequelize-cli db:drop && sequelize-cli db:create && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "db:export": "node scripts/db-export.js",
    "db:import": "node scripts/db-import.js",
    "db:restore-plans": "node scripts/restore-plan-data-from-backup.js",
    "db:validate-migrations": "node scripts/validate-migrations.js",
    "seed:alt-mom": "sequelize-cli db:seed --seed 20260616000001-seed-alternative-minister-of-mines-structure.js",
    "seed:alt-mom-institutes": "sequelize-cli db:seed --seed 20260616000002-seed-alternative-mom-institutes-structure.js",
    "seed:mom-demo-plan": "sequelize-cli db:seed --seed 20260506000001-seed-mom-demo-plan.js",
    "seed:organogram-users": "sequelize-cli db:seed --seed 20260617000001-seed-organogram-department-users.js",
    "seed:admin": "node scripts/reseed-admin-permissions.js",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "make:migration": "sequelize-cli migration:generate --name",
    "make:seed": "sequelize-cli seed:generate --name",
    "make:model": "sequelize-cli model:generate --name"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-validator": "^7.3.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "libphonenumber-js": "^1.12.25",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "nodemon": "^3.1.10",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "smpp": "^0.6.0-rc.4",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.10.4"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.3"
  }
}