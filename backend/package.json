{
  "name": "novacure-platform-api",
  "version": "1.0.0",
  "description": "NovaCure Platform — enterprise healthcare ecosystem API",
  "main": "app.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --runInBand --forceExit",
    "test:smoke": "jest --runInBand --forceExit --testPathPattern=tests/smoke",
    "test:security": "jest --runInBand --forceExit --testPathPattern=tests/security",
    "test:ci": "jest --runInBand --forceExit --testPathPattern=\"tests[/\\\\](smoke|security)\"",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:create": "sequelize-cli db:create",
    "db:drop": "sequelize-cli db:drop",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate",
    "db:reset:seed": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "db:fresh": "sequelize-cli db:drop && sequelize-cli db:create && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "db:baseline:mark": "node scripts/mark-baseline-migrations.js",
    "seed": "sequelize-cli db:seed:all",
    "seed:diagram-images": "node scripts/seedMedicalDiagramImages.js",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "make:migration": "sequelize-cli migration:generate --name",
    "make:seed": "sequelize-cli seed:generate --name",
    "make:model": "sequelize-cli model:generate --name"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.25",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "maxWorkers": 1,
    "forceExit": true,
    "testTimeout": 30000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ]
  }
}
