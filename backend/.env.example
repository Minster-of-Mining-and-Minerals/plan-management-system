PORT=4000
JWT_SECRET=dev-only-change-me-to-a-long-random-secret
# Preferred expiry name (JWT_EXPIRATION_TIME is accepted as an alias)
JWT_EXPIRES_IN=12h

DB_USERNAME=postgres
DB_PASSWORD=your-db-password
DB_NAME=novacure
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# Direct dev ports (:3000 / :4000)
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:4000

# Behind Nginx on port 80 (use with docker-compose.proxy.yml)
# FRONTEND_URL=http://localhost
# BASE_URL=http://localhost

# Production HTTPS example
# FRONTEND_URL=https://novacure.example.com
# BASE_URL=https://novacure.example.com

# Serve non-attachment uploads statically (diagrams, etc.). Attachment PHI is always gated.
# SERVE_UPLOADS_STATIC=false
# ENABLE_SWAGGER=true

APP_NAME=NovaCure Platform
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
EMAIL_FROM=NovaCure Platform <your-email@example.com>
