# Local backend development (copy to backend/.env)
DB_USERNAME=plan_user
DB_PASSWORD=plan_password
DB_NAME=plan_management
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

JWT_SECRET=replace-with-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

PORT=4000
HOST=0.0.0.0
SOCKET_PORT=5000
SOCKET_HOST=0.0.0.0

# Optional: override seeded Super Admin password (dev only)
# SEED_ADMIN_PASSWORD=change-me-on-first-login

FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
BASE_URL=http://localhost:4000

# Deployment server 10.0.71.213
# FRONTEND_URL=http://10.0.71.213:3000
# APP_URL=http://10.0.71.213:3000
# BASE_URL=http://10.0.71.213:4000
# BACKEND_PUBLIC_URL=http://10.0.71.213:4000
# API_PUBLIC_URL=http://10.0.71.213:4000/api
# APP_DOMAIN=10.0.71.213
# ONLYOFFICE_URL=http://10.0.71.213:8080
# COLLABORATION_PUBLIC_URL=http://10.0.71.213:4000
