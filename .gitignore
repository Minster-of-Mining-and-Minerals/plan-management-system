# Node modules
/backend/node_modules/

# Environment variables
/.env
/backend/.env
# Ignore uploads
/backend/uploads/
/backend/public/uploads/
/backend/tmp/
# Logs
logs/
*.log

# OS files
/backend/.DS_Store
/backend/Thumbs.db

# Build outputs
/backend/dist/
/backend/build/

# Database backups (may contain sensitive data)
/database/backups/*.sql

# Collaboration service
/collaboration-service/node_modules/
/collaboration-service/.env
/collaboration-service/storage/

# TLS certificates and server-specific HTTPS config (generated on the server)
/nginx/ssl/*.pem
/nginx/conf.d/app-ssl.conf
/nginx/certbot-www/
