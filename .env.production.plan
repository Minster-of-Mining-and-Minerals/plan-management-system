# Node Environment
NODE_ENV=production

# Server Configuration
PORT=4000
HOST=0.0.0.0
SOCKET_PORT=5000
SOCKET_HOST=0.0.0.0
TRUST_PROXY=true

# Domains
APP_DOMAIN=plan.system.com.et
APP_URL=https://plan.system.com.et
AUTH_URL=https://plan.system.com.et
FRONTEND_URL=https://plan.system.com.et
BASE_URL=https://plan.system.com.et
API_PUBLIC_URL=https://plan.system.com.et/api
BACKEND_PUBLIC_URL=https://plan.system.com.et
COLLABORATION_PUBLIC_URL=https://plan.system.com.et/api/v1
ONLYOFFICE_URL=https://plan.system.com.et/onlyoffice

# NextJS Frontend
NEXT_PUBLIC_BASE_URL=https://plan.system.com.et/api
NEXT_PUBLIC_FILE_URL=https://plan.system.com.et
NEXT_PUBLIC_SOCKET_URL=https://plan.system.com.et
NEXT_PUBLIC_SOCKET_PORT=443
NEXT_PUBLIC_FRONTEND_URL=https://plan.system.com.et
NEXT_PUBLIC_DEPLOYMENT_MODE=nginx
NEXT_PUBLIC_COLLABORATION_API_URL=https://plan.system.com.et/api/v1
NEXT_PUBLIC_ONLYOFFICE_URL=https://plan.system.com.et/onlyoffice

# Authentication Secrets
AUTH_SECRET=plan_management_super_secure_auth_secret_2026_xyz!
NEXTAUTH_SECRET=plan_management_super_secure_nextauth_secret_2026_xyz!
JWT_SECRET=plan_management_super_secure_jwt_secret_2026_xyz!

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_DIALECT=postgres
DB_USERNAME=plan_user
DB_PASSWORD=plan_super_secure_db_password_2026
DB_NAME=plan_management
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
ENABLE_DASHBOARD_METRICS=true

# Collaboration Database Configuration
COLLABORATION_DB_HOST=db
COLLABORATION_DB_PORT=5432
COLLABORATION_DB_USERNAME=plan_user
COLLABORATION_DB_PASSWORD=plan_super_secure_db_password_2026
COLLABORATION_DB_NAME=collaboration_service

# Database Initialization
RUN_DB_MIGRATIONS=true
RUN_COLLABORATION_MIGRATIONS=true
RUN_DB_SEEDERS=true

# ONLYOFFICE / Collaboration Integration
ONLYOFFICE_JWT_ENABLED=true
ONLYOFFICE_JWT_SECRET=plan_management_onlyoffice_jwt_secret_2026
FILE_TOKEN_SECRET=plan_management_file_token_secret_2026
FILE_TOKEN_TTL_SECONDS=3600

# Nginx Ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
