# HTTPS virtual host — copy to app-ssl.conf when TLS certificates are ready.
# See nginx/ssl/README.md
#
# Replace server_name with your production domain (APP_DOMAIN in .env).

server {
    listen 443 ssl http2;
    server_name localhost;

    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/app-locations.conf;
}

# Optional HTTP -> HTTPS redirect (uncomment after TLS is working)
# server {
#     listen 80;
#     server_name your-domain.example.gov.et;
#     return 301 https://$host$request_uri;
# }
