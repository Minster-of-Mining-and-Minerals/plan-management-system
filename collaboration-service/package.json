{
  "name": "collaboration-service",
  "version": "1.0.0",
  "description": "ONLYOFFICE document collaboration microservice for MoM applications",
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "db:create": "sequelize-cli db:create",
    "make:migration": "sequelize-cli migration:generate --name",
    "onlyoffice:up": "docker compose up -d",
    "onlyoffice:down": "docker compose down",
    "onlyoffice:logs": "docker compose logs -f onlyoffice"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemon": "^3.1.10",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.3"
  }
}
