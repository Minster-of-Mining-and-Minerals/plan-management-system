PORT=4100
NODE_ENV=development

# Shared with plan-management backend (same JWT_SECRET for user tokens)
JWT_SECRET=your-jwt-secret-must-match-main-backend

# Collaboration service database (separate from main app DB)
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=collaboration_service
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# Public URL ONLYOFFICE uses to download files and post callbacks.
# From Docker on Linux use host.docker.internal, e.g. http://host.docker.internal:4100
COLLABORATION_PUBLIC_URL=http://localhost:4100

# Main plan-management API (for user profile + access policy checks)
PLAN_API_URL=http://localhost:4000/api

# ONLYOFFICE Document Server (browser loads editor script from here)
ONLYOFFICE_URL=http://localhost:8080
ONLYOFFICE_JWT_ENABLED=false
ONLYOFFICE_JWT_SECRET=onlyoffice-jwt-secret

# Short-lived tokens for ONLYOFFICE file/callback endpoints
FILE_TOKEN_SECRET=collaboration-file-token-secret
FILE_TOKEN_TTL_SECONDS=3600

# Local file storage
DOCUMENT_STORAGE_PATH=./storage/documents

# CORS
FRONTEND_URL=http://localhost:3000
