# =============================================================================
# Plan Management System — environment template
# Copy to `.env` in the repository root before `docker compose up`.
# =============================================================================

# --- Database (Docker service: db) -------------------------------------------
DB_USERNAME=plan_user
DB_PASSWORD=change-me-plan-password
DB_NAME=plan_management
DB_HOST=db
DB_PORT=5432
DB_DIALECT=postgres

# --- Auth (generate: openssl rand -base64 32) --------------------------------
AUTH_SECRET=replace-with-at-least-32-characters
NEXTAUTH_SECRET=replace-with-at-least-32-characters
JWT_SECRET=replace-with-jwt-secret

# --- Public URLs (Nginx mode — default docker compose) -----------------------
# Single origin on port 80; Nginx routes /api to backend and / to frontend.
APP_URL=http://localhost
AUTH_URL=http://localhost
FRONTEND_URL=http://localhost
BASE_URL=http://localhost
API_PUBLIC_URL=http://localhost/api
BACKEND_PUBLIC_URL=http://localhost
APP_DOMAIN=localhost

NEXT_PUBLIC_BASE_URL=http://localhost/api
NEXT_PUBLIC_FILE_URL=http://localhost
NEXT_PUBLIC_SOCKET_URL=http://localhost
NEXT_PUBLIC_SOCKET_PORT=5000
DEPLOYMENT_MODE=nginx

# --- Deployment server 10.0.71.213 (Nginx on port 80) -------------------------
# APP_URL=http://10.0.71.213
# AUTH_URL=http://10.0.71.213
# FRONTEND_URL=http://10.0.71.213
# BASE_URL=http://10.0.71.213
# API_PUBLIC_URL=http://10.0.71.213/api
# BACKEND_PUBLIC_URL=http://10.0.71.213
# APP_DOMAIN=10.0.71.213
# NEXT_PUBLIC_BASE_URL=http://10.0.71.213/api
# NEXT_PUBLIC_FILE_URL=http://10.0.71.213
# NEXT_PUBLIC_SOCKET_URL=http://10.0.71.213
# NEXT_PUBLIC_SOCKET_PORT=5000
# NEXT_PUBLIC_COLLABORATION_API_URL=http://10.0.71.213/api/v1
# NEXT_PUBLIC_ONLYOFFICE_URL=http://10.0.71.213/onlyoffice
# ONLYOFFICE_URL=http://10.0.71.213/onlyoffice
# NGINX_HTTP_PORT=80
# DEPLOYMENT_MODE=nginx

# --- Deployment server 10.0.71.213 (direct ports) -----------------------------
# APP_URL=http://10.0.71.213:3000
# AUTH_URL=http://10.0.71.213:3000
# FRONTEND_URL=http://10.0.71.213:3000
# NEXT_PUBLIC_BASE_URL=http://10.0.71.213:4000/api
# NEXT_PUBLIC_FILE_URL=http://10.0.71.213:4000
# NEXT_PUBLIC_SOCKET_URL=http://10.0.71.213:5000
# NEXT_PUBLIC_COLLABORATION_API_URL=http://10.0.71.213:4000/api/v1
# NEXT_PUBLIC_ONLYOFFICE_URL=http://10.0.71.213:8080
# ONLYOFFICE_URL=http://10.0.71.213:8080
# FRONTEND_PUBLISH_PORT=3000
# BACKEND_PUBLISH_PORT=4000
# SOCKET_PUBLISH_PORT=5000
# ONLYOFFICE_PUBLISH_PORT=8080
# DEPLOYMENT_MODE=direct

# --- Public URLs (direct mode — use with docker-compose.direct.yml) ----------
# APP_URL=http://localhost:3000
# AUTH_URL=http://localhost:3000
# FRONTEND_URL=http://localhost:3000
# NEXT_PUBLIC_BASE_URL=http://localhost:4000/api
# NEXT_PUBLIC_FILE_URL=http://localhost:4000
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# NEXT_PUBLIC_COLLABORATION_API_URL=http://localhost:4000/api/v1
# NEXT_PUBLIC_ONLYOFFICE_URL=http://localhost:8080
# ONLYOFFICE_URL=http://localhost:8080
# DEPLOYMENT_MODE=direct

# --- Production example ------------------------------------------------------
# APP_URL=https://plans.example.gov.et
# AUTH_URL=https://plans.example.gov.et
# FRONTEND_URL=https://plans.example.gov.et
# APP_DOMAIN=plans.example.gov.et
# NEXT_PUBLIC_BASE_URL=https://plans.example.gov.et/api
# NEXT_PUBLIC_FILE_URL=https://plans.example.gov.et
# NEXT_PUBLIC_SOCKET_URL=https://plans.example.gov.et
# NEXT_PUBLIC_COLLABORATION_API_URL=https://plans.example.gov.et/api/v1
# ONLYOFFICE_URL=https://plans.example.gov.et/onlyoffice
# NEXT_PUBLIC_ONLYOFFICE_URL=https://plans.example.gov.et/onlyoffice
# ONLYOFFICE_JWT_ENABLED=true

# --- Docker / runtime --------------------------------------------------------
TRUST_PROXY=true
APP_TIMEZONE=Africa/Addis_Ababa
RUN_DB_MIGRATIONS=true
RUN_COLLABORATION_MIGRATIONS=true
RUN_DB_SEEDERS=false

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Collaboration + ONLYOFFICE (integrated in backend at /api/v1/documents) ---
COLLABORATION_DB_NAME=collaboration_service
# URL ONLYOFFICE uses to download/save files (Docker internal network)
COLLABORATION_PUBLIC_URL=http://backend:4000
# Browser-facing Document Server URL (Nginx mode — proxied at /onlyoffice/)
ONLYOFFICE_URL=http://localhost/onlyoffice
ONLYOFFICE_JWT_ENABLED=false
ONLYOFFICE_JWT_SECRET=change-me-onlyoffice-jwt-secret
FILE_TOKEN_SECRET=change-me-collaboration-file-token
FILE_TOKEN_TTL_SECONDS=3600
NEXT_PUBLIC_COLLABORATION_API_URL=http://localhost/api/v1
NEXT_PUBLIC_ONLYOFFICE_URL=http://localhost/onlyoffice

# Optional direct port publishing (docker-compose.direct.yml)
# FRONTEND_PUBLISH_PORT=3000
# BACKEND_PUBLISH_PORT=4000
# SOCKET_PUBLISH_PORT=5000
# DB_PUBLISH_PORT=5432
# ONLYOFFICE_PUBLISH_PORT=8080
# ONLYOFFICE_URL=http://localhost:8080
# NEXT_PUBLIC_ONLYOFFICE_URL=http://localhost:8080
# NEXT_PUBLIC_COLLABORATION_API_URL=http://localhost:4000/api/v1

